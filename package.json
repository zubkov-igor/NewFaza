{
    "name": "NewFaza",
    "version": "0.9.6",
    "description": "New Faza cool viewer",
    "main": "index.js",
    "author": "Igor Zubkov",
    "email": "zubkov.igorv@gmail.com",
    "license": "MIT",
    "scripts": {
        "start": "electron index.js",
        "build": "electron-packager . NewFaza --platform=win32 --arch=x64 --out=NewFaza --icon=img/logo.ico --overwrite --app-version=0.9.0 --description='New Faza cool viewer'"
    },
    "dependencies": {
        "@serialport/bindings-cpp": "^12.0.1",
        "axios": "^1.7.9",
        "chart.js": "^4.4.4",
        "chartjs-plugin-annotation": "^3.0.1",
        "chartjs-plugin-dragdata": "^2.3.1",
        "chartjs-plugin-zoom": "^2.0.1",
        "fast-csv": "^5.0.2",
        "modbus-serial": "^8.0.17",
        "mysql2": "^3.12.0",
        "node-gyp": "^10.2.0",
        "quickchart-js": "^3.1.3"
    },
    "devDependencies": {
        "electron": "^32.0.1",
        "electron-builder": "^25.1.8",
        "electron-packager": "^17.1.2"
    },
    "build": {
        "appId": "com.newfaza.app",
        "files": [
            "**/*"
        ],
        "icon": "img/logo.ico",
        "buildDependenciesFromSource": true,
        "win": {
            "target": "NSIS",
            "icon": "img/logo.ico",
            "requestedExecutionLevel": "asInvoker"
        },
        "asar": true
    }
}
